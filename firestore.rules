rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function price(value) { return value == null || (value is number && value >= 0 && value <= 99999); }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write, list: if false;
    }
    match /settings/catalogV2 {
      allow read: if true;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['individual','pack','ers','pro']) && request.resource.data.keys().hasAll(['individual','pack','ers','pro']) && price(request.resource.data.individual) && price(request.resource.data.ers) && price(request.resource.data.pro) && price(request.resource.data.pack);
    }
    match /settings/promotion {
      allow read: if true;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['price','endDate','enabled'])
        && request.resource.data.price is number && price(request.resource.data.price)
        && request.resource.data.enabled is bool && request.resource.data.endDate is string
        && request.resource.data.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /feedbacks/{uid} {
      allow read: if admin() || resource.data.status == 'approved' || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','rating','comment','status','createdAt','product'])
        && request.resource.data.keys().hasAll(['name','rating','comment','status','createdAt','product'])
        && request.resource.data.product in ['individual','pack','ers','pro','other']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1200
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['pending','approved','rejected'];
      allow delete: if admin();
    }
    match /cashEntries/{entryId} {
      allow read, delete: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['date','type','description','category','cents','updatedAt'])
        && request.resource.data.keys().hasAll(['date','type','description','category','cents','updatedAt'])
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.type in ['income','expense']
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 60
        && request.resource.data.cents is int && request.resource.data.cents > 0 && request.resource.data.cents <= 100000000
        && request.resource.data.updatedAt == request.time;
    }
    match /posts/{postId} {
      allow read: if admin() || resource.data.published == true;
      allow delete: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['title','body','image','video','category','published','createdAt','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 5000
        && request.resource.data.image is string && request.resource.data.image.size() <= 2000
        && (request.resource.data.image == '' || request.resource.data.image.matches('https://.*'))
        && (!('video' in request.resource.data) || (request.resource.data.video is string && request.resource.data.video.size() <= 2000 && (request.resource.data.video == '' || request.resource.data.video.matches('https://.*'))))
        && request.resource.data.category in ['novidade','promocao']
        && request.resource.data.published is bool
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
    }
  }
}
